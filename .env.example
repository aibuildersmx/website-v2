# AI Builders MX — environment variables
#
# Copy to `.env.local` for local dev and fill in real values.
# On Railway these are set as service variables (see README / CLAUDE.md).
# NEVER commit real values — this file documents names only.
#
# Both the web service (`pnpm start`) and the worker service (`pnpm worker`)
# read the SAME set below. On Railway, define them once as Shared Variables and
# reference them from both services so they don't drift.

# --- Database (web + worker) -------------------------------------------------
# Railway Postgres connection string. pg-boss runs its own `pgboss` schema here.
DATABASE_URL=

# --- Newsletter / Resend (web + worker) --------------------------------------
# Resend API key. Also used to HMAC-sign the one-click unsubscribe links.
RESEND_API_KEY=
# Verified "from" address, e.g. "The Build Log <hola@aibuilders.mx>".
NEWSLETTER_FROM=
# Optional reply-to address. Leave blank to omit.
NEWSLETTER_REPLY_TO=
# Base URL used to build unsubscribe links in sent emails.
# Defaults to https://aibuilders.mx if unset.
NEXT_PUBLIC_SITE_URL=

# --- Admin seed (one-time, `pnpm db:seed-admin` only) ------------------------
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
